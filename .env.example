# Application
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
RUNTIME_DATA_DIR=data/runtime

# PostgreSQL is introduced in a later phase. Supply credentials locally only.
# DATABASE_URL=postgresql://user:password@localhost:5432/ol_english_marker

# Local model runtime (integration is planned for a later phase)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GRADING_MODEL=llama2
# OLLAMA_OCR_MODEL=

# Local vector persistence (integration is planned for a later phase)
CHROMA_PERSIST_DIR=data/chroma

# Workflow defaults for future phases
OCR_CONFIDENCE_THRESHOLD=0.80
GRADING_CONFIDENCE_THRESHOLD=0.70
RETRIEVAL_TOP_K=5

# PDF ingestion
MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=100
PDF_RENDER_DPI=150
