# Application
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
RUNTIME_DATA_DIR=data/runtime

# PostgreSQL checkpoint storage; configure a private database locally.
# DATABASE_URL=postgresql://user:password@localhost:5432/ol_english_marker

# Local model runtime. OCR images must only be sent to a loopback endpoint.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GRADING_MODEL=llama2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GRADING_TIMEOUT_SECONDS=300
# OLLAMA_OCR_MODEL=
OLLAMA_OCR_TIMEOUT_SECONDS=900

# Classical OCR baseline
# Optional when Tesseract is not on PATH; Windows standard install paths are
# discovered automatically.
# TESSERACT_EXECUTABLE='C:\Program Files\Tesseract-OCR\tesseract.exe'
TESSERACT_LANGUAGE=eng
TESSERACT_PSM=6
TESSERACT_TIMEOUT_SECONDS=120

# Local syllabus and marking-scheme vector index
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=ol_english_knowledge
SYLLABUS_PDF_PATH=data/syllabus/grade-10-english-syllabus-68d2609d3a1ea.pdf

# Workflow defaults for future phases
OCR_CONFIDENCE_THRESHOLD=0.80
GRADING_CONFIDENCE_THRESHOLD=0.70
RETRIEVAL_TOP_K=5

# PDF ingestion
MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=100
PDF_RENDER_DPI=150

# Streamlit synthetic UI scenarios (never real examination marking)
UI_DEMO_ENABLED=false

GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=300
